# Copy to backend/.env and fill in. Never commit backend/.env.
# Get a free key at https://aistudio.google.com/apikey

# One key, or several comma-separated keys (extra keys add free-tier daily quota).
GEMINI_API_KEY=
GEMINI_API_KEYS=

# gemini = Google AI Studio keys (default). vertex = Vertex AI express-mode keys (start with "AQ.").
GEMINI_BACKEND=gemini

# Models (optional overrides). Fallbacks are tried automatically when a daily quota runs out.
GEMINI_CHEAP_MODEL=gemini-3.5-flash
# GEMINI_CHEAP_FALLBACKS=gemini-3.1-flash-lite,gemini-3.5-flash-lite
# GEMINI_STRONG_MODEL=gemini-3.5-flash
# GEMINI_STRONG_FALLBACKS=gemini-3.8-flash,gemini-3.1-flash-lite
